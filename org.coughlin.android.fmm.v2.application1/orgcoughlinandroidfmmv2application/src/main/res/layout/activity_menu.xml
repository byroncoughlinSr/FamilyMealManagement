<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:padding="16dp"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/linearLayout3"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingVertical="20dp">


        <ScrollView
            android:id="@+id/scrollView2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textView2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#05FDD835"
                    android:gravity="center"
                    android:text="@string/menu"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardViewMonday"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="32dp"
                    android:layout_marginEnd="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textViewMonday"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/monday" />

                        <TextView
                            android:id="@+id/textViewMondayBreakfast"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/breakfast" />

                        <TextView
                            android:id="@+id/TextViewMondayLunch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/lunch" />

                        <TextView
                            android:id="@+id/textViewMondayDinner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/dinner" />

                        <TextView
                            android:id="@+id/textViewMondaySnack"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/snack" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardViewTuesday"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="40dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cardViewMonday">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textViewTuesday"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/tuesday" />

                        <TextView
                            android:id="@+id/textViewTuesdayBreakfast"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/breakfast" />

                        <TextView
                            android:id="@+id/TextViewTuesdayLunch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/lunch" />

                        <TextView
                            android:id="@+id/textViewTuesdayDinner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/dinner" />

                        <TextView
                            android:id="@+id/textViewTuesdaySnack"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/snack" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardViewWednesday"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="40dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cardViewTuesday">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textViewWednesday"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/wednesday" />

                        <TextView
                            android:id="@+id/textViewWednesdayBreakfast"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/breakfast" />

                        <TextView
                            android:id="@+id/TextViewWednesdayLunch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/lunch" />

                        <TextView
                            android:id="@+id/textViewWednesdayDinner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/dinner" />

                        <TextView
                            android:id="@+id/textViewWednesdaySnack"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/snack" />
                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardViewThursday"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="32dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="1.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cardViewWednesday">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textViewThursday"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/thursday" />

                        <TextView
                            android:id="@+id/textViewThursdayBreakfast"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/breakfast" />

                        <TextView
                            android:id="@+id/TextViewThursdayLunch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/lunch" />

                        <TextView
                            android:id="@+id/textViewThursdayDinner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/dinner" />

                        <TextView
                            android:id="@+id/textViewThursdaySnack"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/snack" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardViewFriday"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="32dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cardViewThursday">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textViewFriday"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/friday" />

                        <TextView
                            android:id="@+id/textViewFridayBreakfast"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/breakfast" />

                        <TextView
                            android:id="@+id/TextViewFridayLunch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/lunch" />

                        <TextView
                            android:id="@+id/textViewFridayDinner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/dinner" />

                        <TextView
                            android:id="@+id/textViewFridaySnack"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/snack" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardViewSaturday"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="32dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cardViewFriday"
                    app:layout_constraintVertical_bias="0.156">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textViewSaturday"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/saturday" />

                        <TextView
                            android:id="@+id/textViewSaturdayBreakfast"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/breakfast" />

                        <TextView
                            android:id="@+id/TextViewSaturdayLunch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/lunch" />

                        <TextView
                            android:id="@+id/textViewSaturdayDinner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/dinner" />

                        <TextView
                            android:id="@+id/textViewSaturdaySnack"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/snack" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardViewSunday"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="32dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cardViewSaturday"
                    app:layout_constraintVertical_bias="0.156">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textViewSunday"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/sunday" />

                        <TextView
                            android:id="@+id/textViewSundayBreakfast"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/breakfast" />

                        <TextView
                            android:id="@+id/TextViewSundayLunch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/lunch" />

                        <TextView
                            android:id="@+id/textViewSundayDinner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/dinner" />

                        <TextView
                            android:id="@+id/textViewSundaySnack"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/snack" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ListView
        android:id="@+id/left_drawer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#111"
        android:choiceMode="singleChoice"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"></ListView>
</androidx.drawerlayout.widget.DrawerLayout>
