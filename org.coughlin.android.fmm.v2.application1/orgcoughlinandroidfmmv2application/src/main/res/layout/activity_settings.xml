<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/gradient_background">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ToolbarPopupTheme" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_llm_provider_label"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/spinnerLlmProvider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:id="@+id/ollamaFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_free_tier_ollama"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="italic"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_ollama_url"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/editOllamaUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:singleLine="true"
                    android:background="@android:color/white"
                    android:textColor="#000000"
                    android:textColorHint="#888888"
                    android:hint="http://your-server:11434/api/generate"
                    android:padding="8dp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_ollama_model"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/spinnerOllamaModel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/white"
                    android:minHeight="40dp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/spinnerOllamaModelStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:visibility="gone"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btnTestConnection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_test_connection"
                    android:layout_marginBottom="24dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/geminiFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_free_tier_gemini"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="italic"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_api_key"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/editTextApiKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:background="@android:color/white"
                    android:textColor="#000000"
                    android:textColorHint="#888888"
                    android:hint="Enter API key"
                    android:padding="8dp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_gemini_model"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/spinnerGeminiModel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/white"
                    android:minHeight="40dp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/spinnerGeminiModelStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:visibility="gone"
                    android:layout_marginBottom="24dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/claudeFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_free_tier_claude"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="italic"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_claude_api_key"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/editTextClaudeApiKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:background="@android:color/white"
                    android:textColor="#000000"
                    android:textColorHint="#888888"
                    android:hint="Enter Anthropic API key"
                    android:padding="8dp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_claude_model"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/spinnerClaudeModel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/white"
                    android:minHeight="40dp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/spinnerClaudeModelStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:visibility="gone"
                    android:layout_marginBottom="24dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/groqFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_free_tier_groq"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="italic"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_groq_api_key"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/editTextGroqApiKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:background="@android:color/white"
                    android:textColor="#000000"
                    android:textColorHint="#888888"
                    android:hint="Enter Groq API key"
                    android:padding="8dp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_groq_model"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/spinnerGroqModel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/white"
                    android:minHeight="40dp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/spinnerGroqModelStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:visibility="gone"
                    android:layout_marginBottom="24dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/openaiFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_free_tier_openai"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="italic"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_openai_api_key"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/editTextOpenAiApiKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:background="@android:color/white"
                    android:textColor="#000000"
                    android:textColorHint="#888888"
                    android:hint="Enter OpenAI API key"
                    android:padding="8dp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_openai_model"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/spinnerOpenAiModel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/white"
                    android:minHeight="40dp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/spinnerOpenAiModelStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:visibility="gone"
                    android:layout_marginBottom="24dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/grokFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_free_tier_grok"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="italic"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_grok_api_key"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/editTextGrokApiKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:background="@android:color/white"
                    android:textColor="#000000"
                    android:textColorHint="#888888"
                    android:hint="Enter xAI API key"
                    android:padding="8dp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_grok_model"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/spinnerGrokModel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/white"
                    android:minHeight="40dp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/spinnerGrokModelStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:visibility="gone"
                    android:layout_marginBottom="24dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/onDeviceFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_on_device_info"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="24dp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_dinner_images_label"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_pexels_api_key"
                android:textColor="@android:color/white"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/editTextPexelsApiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:singleLine="true"
                android:background="@android:color/white"
                android:textColor="#000000"
                android:textColorHint="#888888"
                android:hint="Enter Pexels API key"
                android:padding="8dp"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_prompt_label"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/editMenuPrompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="5"
                android:maxLines="12"
                android:inputType="textMultiLine|textCapSentences"
                android:gravity="top|start"
                android:scrollbars="vertical"
                android:scrollbarStyle="insideInset"
                android:overScrollMode="always"
                android:background="@android:color/white"
                android:textColor="#000000"
                android:textColorHint="#888888"
                android:padding="8dp"
                android:layout_marginBottom="4dp" />

            <ImageButton
                android:id="@+id/btnMenuPromptMic"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end"
                android:src="@drawable/ic_mic"
                android:contentDescription="@string/settings_dictate_menu_prompt"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_recipe_prompt_label"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/editRecipePrompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="4"
                android:maxLines="10"
                android:inputType="textMultiLine|textCapSentences"
                android:gravity="top|start"
                android:scrollbars="vertical"
                android:scrollbarStyle="insideInset"
                android:overScrollMode="always"
                android:background="@android:color/white"
                android:textColor="#000000"
                android:textColorHint="#888888"
                android:padding="8dp"
                android:layout_marginBottom="4dp" />

            <ImageButton
                android:id="@+id/btnRecipePromptMic"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end"
                android:src="@drawable/ic_mic"
                android:contentDescription="@string/settings_dictate_recipe_prompt"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_schedule_label"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_schedule_day"
                android:textColor="@android:color/white"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/spinnerScheduleDay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_schedule_time"
                android:textColor="@android:color/white"
                android:layout_marginBottom="4dp" />

            <TimePicker
                android:id="@+id/timePickerSchedule"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp" />

            <Button
                android:id="@+id/btnSaveSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/save_settings" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
